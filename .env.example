# Optional OpenAI-compatible model. Leave OPENAI_API_KEY empty for deterministic analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional endpoint for an OpenAI-compatible provider (for example, a local inference server).
OPENAI_BASE_URL=

# Network and crawl safeguards
REQUEST_TIMEOUT=8
SEARCH_TIMEOUT=8
MAX_PAGES=20
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=3
